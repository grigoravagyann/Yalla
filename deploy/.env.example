# Yalla production configuration. Copy to .env in this folder and fill in every line marked
# CHANGE. Nothing else in the package holds a value: compose.yaml interpolates ${...} from this
# file, and the api container receives every line below as an environment variable (a double
# underscore is a colon in the API's configuration, so Jwt__SigningKey is Jwt:SigningKey).
#
# ${DOMAIN} inside a value is expanded by Compose when it reads this file as env_file (Compose
# 2.24 or later), so the domain is typed once. Values with spaces or quotes need no quoting;
# a value that contains `$` has to write it as `$$`. Keep this file at mode 600: it holds every
# secret the deployment has. Never commit .env; .env.example is the only one in git.
#
# Generation hints assume `openssl` on the host. Any other source of 32+ random bytes is fine.

# ---------------------------------------------------------------- domain and version

# The one public hostname. Caddy obtains a certificate for it; every URL below hangs off it.
DOMAIN=yalla.am                                              # CHANGE

# Which api/web images to run: a git SHA, a v* tag or `latest` as pushed by the publish
# workflows. Pin a SHA for a deployment you can roll back to by name; `latest` for a first try.
YALLA_VERSION=latest

# The compose network's address range, which the API trusts X-Forwarded-* from (compose.yaml).
# Only change it if 172.28.0.0/16 collides with a network the host can already reach.
YALLA_SUBNET=172.28.0.0/16

# ---------------------------------------------------------------- database

# SQL Server's sa password. Its complexity rule needs three of: upper, lower, digit, symbol, so
# plain hex is refused:  echo "$(openssl rand -hex 16)Aa1!"
# No `;` and no `'` - the value is spliced into the connection string on the next line.
SQL_SA_PASSWORD=Change-me-to-32-random-chars-Aa1!            # CHANGE

# The API's connection string. `sql` is the container's name on the compose network; Encrypt with
# TrustServerCertificate because the image's certificate is self-signed. The migrate service uses
# this same string as YALLA_MIGRATIONS_CONNECTION. Leave it as is unless you point at a database
# outside this host - then remove the sql service from compose.yaml too.
ConnectionStrings__Yalla=Server=sql,1433;Database=Yalla;User Id=sa;Password=${SQL_SA_PASSWORD};Encrypt=True;TrustServerCertificate=True

# ---------------------------------------------------------------- identity

# Signs every access token. 32 bytes minimum or startup fails:  openssl rand -hex 32
# Rotating it signs everyone out, which is the point of rotating it.
Jwt__SigningKey=change-me-0000000000000000000000000000000000000000000000000000000   # CHANGE

# The first platform admin, created on the first start if no account has this address. An
# existing admin's password is never reset from here, so after the first sign-in these can be
# removed. Password: 12 characters or more.
PlatformAdmin__Email=admin@yalla.am                          # CHANGE
PlatformAdmin__Password=change-me-twelve-plus                # CHANGE

# ---------------------------------------------------------------- links the API hands out

# Where a password-reset / sign-in-issuance link points. The console's /reset-password route;
# {token} is replaced by the API and stays in the fragment so it never reaches an access log.
# Required: must be absolute https and must not be loopback.
Auth__PasswordResetUrlTemplate=https://${DOMAIN}/reset-password#token={token}

# Where a web booking's manage/cancel link points. Written into the booking at creation and
# never repairable afterwards, so it has to be right before the first booking. Required.
# The path must stay /booking/{token}: the web's public page serves that token-only route and reads
# the branch from the booking (venueSlug/branchSlug), and "booking" is a reserved venue slug.
# DeployEnvExampleTests pins it.
PublicWeb__ManageBookingUrlTemplate=https://${DOMAIN}/booking/{token}

# Where a tab's share link points. The diner app's /join/[token] route and its Android intent
# filter match this domain, so it is not derived from DOMAIN on purpose: changing it changes
# what the published app opens.
Tabs__JoinUrlTemplate=https://yalla.am/join/{token}

# ---------------------------------------------------------------- proxy trust
# Set in compose.yaml from YALLA_SUBNET above (ForwardedHeaders__KnownNetworks__0) plus
# 127.0.0.1 for the container's own health check. Nothing to fill in here; README.md
# "Behind a reverse proxy" explains what the API does with it.

# ---------------------------------------------------------------- photos

# Inside the container; the `photos` volume is mounted there (compose.yaml). The Dockerfile
# pre-creates it writable for the app user, and the API refuses to start if it is not.
PhotoStorage__RootPath=/app/.photos

# Minutes between sweeps of photos nothing references any more. 0 switches the sweep off.
PhotoStorage__SweepIntervalMinutes=60

# ---------------------------------------------------------------- logging

# The base default is Error, which hides every request. Information is what you want for the
# first weeks; drop to Warning once it is noisy. Files roll daily in the api_logs volume and the
# same lines go to the console (`./deploy.sh logs`).
Serilog__MinimumLevel__Default=Information

# ---------------------------------------------------------------- push notifications

# Expo posts to phones; Log only writes the rendered message to the log (docs/notifications.md).
Notifications__Channel=Expo

# Only if the Expo project has push security switched on. Otherwise leave empty.
Notifications__ExpoAccessToken=

# Web Push to the staff app's phones and tablets (docs/notifications.md, "Staff push").
# Generate the VAPID pair once - `npx web-push generate-vapid-keys` prints both, base64url -
# and keep it: a new pair makes every phone subscribe again. The private key is a secret.
# Leave the keys empty to log staff pushes instead of sending them.
WebPush__Subject=mailto:ops@${DOMAIN}
WebPush__PublicKey=
WebPush__PrivateKey=

# ---------------------------------------------------------------- Telegram verification

# The phone-verification bot (docs/auth.md, "Telegram verification"). Enabled=false removes its
# routes entirely and nothing below is read. Webhook is the only mode allowed outside Development.
Telegram__Enabled=true
Telegram__Mode=Webhook

# From @BotFather, and the bot's username without the @.
Telegram__BotToken=123456789:change-me                       # CHANGE
Telegram__BotUsername=YallaBot                               # CHANGE

# What Telegram sends back as X-Telegram-Bot-Api-Secret-Token:  openssl rand -hex 32
Telegram__WebhookSecret=change-me-0000000000000000000000000000000000000000000000000000000   # CHANGE

# Registered with Telegram (setWebhook) every time the API starts. Caddy routes /api/* to the
# API, so this is the public form of POST /api/telegram/webhook.
Telegram__WebhookPublicUrl=https://${DOMAIN}/api/telegram/webhook

# ---------------------------------------------------------------- not set on purpose
# RateLimiting__*   on in Production with the limits in appsettings.json; per-address because
#                   the proxy trust above makes addresses real.
# Cors__*           same origin for web and API, so no cross-origin browser access is needed.
# Swagger__Enabled  off; set to true with Swagger__AllowedIps__0=<office address> for a look.
# ASPNETCORE_*      compose.yaml sets ENVIRONMENT=Production, HTTP_PORTS=8080, HTTPS_PORT=443.
