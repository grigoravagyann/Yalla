// Staging configuration.
//
// As with every environment file in this repo: NO SECRETS. The connection
// string below uses Windows authentication (Trusted_Connection), so it carries
// no password and is safe to commit.
//
// If staging moves to a server that needs SQL authentication, do NOT put the
// credentials here. Supply the whole connection string as the environment
// variable ConnectionStrings__Yalla instead - environment variables are read
// after this file and override it.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // appsettings.json sets the default to "Error", which makes a staging box
  // silent - even "Now listening on ..." disappears. Staging exists to be
  // watched, so it logs at Information like Development, minus the SQL command
  // firehose.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },

  "ConnectionStrings": {
    "Yalla": "Server=localhost;Database=Yalla_Staging;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  }
}
