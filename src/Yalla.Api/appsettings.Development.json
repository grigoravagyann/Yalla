{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",

        // Show every SQL command EF Core executes (text + duration). Set to
        // "Warning" or remove this override to silence it again.
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },

  "ConnectionStrings": {
    "Yalla": "Server=localhost;Database=Yalla;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  // NOTE: the local addresses are NOT here. They are in launchSettings.json, which
  // never ships in the publish output - so no deployed environment can inherit a
  // 0.0.0.0 binding or a plain-HTTP endpoint from a config file that does. A run
  // with no profile at all falls back to HTTP on 0.0.0.0:5086, chosen in
  // NetworkExtensions.ListenOnAllInterfacesInDevelopment.

  // Swagger UI at /swagger. On here and nowhere else by default; the setting, not
  // the environment name, is what decides.
  "Swagger": {
    "Enabled": true,
    "AllowedIps": []
  },

  // Returns the verification code in the response body so the diner sign-in flow
  // can be exercised with no SMS provider wired up. Development only - the host
  // refuses to honour this setting in any other environment, so it cannot be
  // switched on with an environment variable in production.
  "Auth": {
    "ReturnVerificationCodeInResponse": true
  },

  // NOTE: Jwt:SigningKey is NOT here and must not be added. It is a secret. Set it
  // once per machine with:
  //
  //   dotnet user-secrets set "Jwt:SigningKey" "<48 random bytes, base64>" --project src/Yalla.Api
  //
  // Startup fails with instructions if it is missing.

  // The pre-authentication actor stub. Real authentication now exists, so this is
  // no longer how the API is used - it is kept because the Prompt 2 integration
  // tests and quick local work against the seeded branch rely on it, and because
  // it is still the fastest way to exercise a manager-only path without minting a
  // token.
  //
  // While Enabled is true its registration REPLACES the real claims-based actor,
  // so every request is attributed to the seeded staff member matching Role and
  // that id is what lands in the audit log. Set Enabled to false to work against
  // real sign-in.
  //
  // While Enabled is true
  // every request is treated as coming from the seeded staff member matching
  // Role, and that id is what lands in the audit log.
  //
  // Set Role to "Manager" to exercise the manager-only operations (writing off a
  // tab); leave it "Waiter" to confirm they refuse. Waiters can perform every
  // table transition, including out-of-service, on purpose.
  //
  // StaffMemberId is optional: left null, the stub uses the seeded waiter or
  // manager, so nothing here has to be updated when the database is recreated.
  //
  // NOTE for the booking endpoints: this stub does NOT get you past them. It
  // replaces ICurrentActor - who the audit log names - and nothing else. The
  // authorisation policies read the bearer token, so POST /api/reservations
  // answers 401 with no token however this section is set. Get a real diner
  // token from POST /api/auth/diner/request-code then /verify-code (the code
  // comes back in the response here), and a manager token from
  // /api/auth/venue/sign-in for approve and reject.
  //
  // GET /api/branches/{id}/availability is anonymous and needs none of this.
  //
  // This section has no effect outside Development, and none at all unless
  // Enabled is true.
  "DevActor": {
    "Enabled": true,
    "Type": "Staff",
    "Role": "Waiter",
    "StaffMemberId": null,
    "DinerUserId": null
  }
}
