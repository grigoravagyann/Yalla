{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",

        // Show every SQL command EF Core executes (text + duration). Set to
        // "Warning" or remove this override to silence it again.
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },

  "ConnectionStrings": {
    "Yalla": "Server=localhost;Database=Yalla;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  // Stands in for authentication, which is the next task. While Enabled is true
  // every request is treated as coming from the seeded staff member matching
  // Role, and that id is what lands in the audit log.
  //
  // Set Role to "Manager" to exercise the manager-only operations (writing off a
  // tab); leave it "Waiter" to confirm they refuse. Waiters can perform every
  // table transition, including out-of-service, on purpose.
  //
  // StaffMemberId is optional: left null, the stub uses the seeded waiter or
  // manager, so nothing here has to be updated when the database is recreated.
  //
  // This section has no effect outside Development, and none at all unless
  // Enabled is true.
  "DevActor": {
    "Enabled": true,
    "Type": "Staff",
    "Role": "Waiter",
    "StaffMemberId": null,
    "DinerUserId": null
  }
}
