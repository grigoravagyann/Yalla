// SECURITY NOTICE
// THIS FILE IS A PLACEHOLDER ONLY.
//
// Do NOT add, commit, or store any secrets here. That includes passwords,
// connection strings, API keys, tokens and encryption keys.
//
// Real configuration values are supplied per environment as environment
// variables (double underscore for nesting, e.g. ConnectionStrings__Yalla).
//
// If this file changes - a new section, a renamed key - the DevOps team must be
// told so the matching environment variables can be added or updated.
{
  "AllowedHosts": "*",

  "ConnectionStrings": {
    // Supplied per environment. See appsettings.Development.json for local work.
    "Yalla": ""
  },

  // Origins allowed by CORS - the diner app, the staff tablet and the admin panel
  // live at different addresses in every environment (environment variables
  // Cors__AllowedOrigins__0, __1, …). Empty = allow-any, logged as a warning at
  // startup; configure the real list before production.
  "Cors": {
    "AllowedOrigins": []
  },

  // Fixed-window rate limits. Enabled defaults to true in Production and false
  // elsewhere; set it explicitly to override (the kill switch). AuthPermitLimit
  // applies to the "auth" policy, which the later identity endpoints will use.
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },

  // What a history of missed bookings costs a diner. Above Threshold no-shows in
  // the last WindowDays, their bookings land as PendingApproval instead of being
  // confirmed instantly - and that is the whole penalty. Nobody is ever banned:
  // Yerevan's dining market is small, and this count cannot tell a serial no-show
  // from somebody whose phone died three times.
  //
  // This is a recommendation, not a settled decision. Enabled: false switches the
  // rule off entirely and also removes a database read from every booking.
  "NoShowPolicy": {
    "Enabled": true,
    "WindowDays": 90,
    "Threshold": 3
  },

  // How long a booking waits for the table's row lock before giving up. Bookers
  // are serialised per table, and the locked span is a range check plus one insert
  // - so five seconds means something is genuinely wrong, not merely busy. A
  // timeout answers 503 with retryable: true, which is deliberately NOT the 409 a
  // real clash gets: one is worth retrying and the other never will be.
  "BookingLock": {
    "LockTimeoutMilliseconds": 5000
  },

  // The operating time zone of the business, as an IANA identifier. Individual
  // branches carry their own Branch.TimeZoneId - every instant in the database is
  // UTC and this is only the default offered when a new branch is created.
  // Armenia has no daylight saving, so UTC+4 holds all year.
  "BusinessDate": {
    "TimeZone": "Asia/Yerevan"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/yalla-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithExceptionDetails"
    ],
    "Properties": {
      "Application": "Yalla"
    }
  }
}
