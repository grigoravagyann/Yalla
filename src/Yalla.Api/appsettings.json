// SECURITY NOTICE
// THIS FILE IS A PLACEHOLDER ONLY.
//
// Do NOT add, commit, or store any secrets here. That includes passwords,
// connection strings, API keys, tokens and encryption keys.
//
// Real configuration values are supplied per environment as environment
// variables (double underscore for nesting, e.g. ConnectionStrings__Yalla).
//
// If this file changes - a new section, a renamed key - the DevOps team must be
// told so the matching environment variables can be added or updated.
{
  "AllowedHosts": "*",

  "ConnectionStrings": {
    // Supplied per environment. See appsettings.Development.json for local work.
    "Yalla": ""
  },

  // Origins allowed by CORS - the diner app, the staff tablet and the admin panel
  // live at different addresses in every environment (environment variables
  // Cors__AllowedOrigins__0, __1, …). An explicit allowlist, never a wildcard.
  // Empty outside Development = NO cross-origin browser access, logged as an error
  // at startup; configure the real list before production. In Development the
  // local network (localhost and private IPv4 origins) is allowed on top of this.
  "Cors": {
    "AllowedOrigins": []
  },

  // Fixed-window rate limits. Enabled defaults to true in Production and false
  // elsewhere; set it explicitly to override (the kill switch).
  //
  // AuthPermitLimit covers the "auth" policy on the sign-in endpoints.
  // CodeRequest* is tighter and covers request-code and password-reset requests:
  // those cost money to send once a provider is wired in.
  // Pin* covers the PIN exchange, and complements - does not replace - the
  // per-staff-member lockout, which is persisted and cleared by a manager.
  //
  // The per-phone-number half of the code-request limit is NOT here: the number
  // is in the request body and this middleware runs before anything reads it, so
  // it lives in Auth:CodeRequestsPerPhonePerHour below.
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "CodeRequestPermitLimit": 5,
    "CodeRequestWindowSeconds": 300,
    "PinPermitLimit": 10,
    "PinWindowSeconds": 60,

    // The anonymous availability query. Generous - a diner sliding the time picker
    // really does make a burst - but finite, because nothing else stands between
    // one phone and a branch's whole floor read.
    "AvailabilityPermitLimit": 60,
    "AvailabilityWindowSeconds": 60,

    // The anonymous public pages: per address, and again per branch for the
    // distributed case that a per-address limit cannot see.
    "PublicPermitLimit": 30,
    "PublicWindowSeconds": 60,
    "PublicBranchPermitLimit": 300,
    "PublicBranchWindowSeconds": 60,

    // And per manage token, for the booking link that went round a group chat.
    // Guessing tokens is bounded by the per-address limit above; this bounds
    // hammering one link that somebody already has.
    "PublicBookingPermitLimit": 20,
    "PublicBookingWindowSeconds": 60
  },

  // OpenAPI exposure. OFF unless Enabled is true - appsettings.Development.json
  // turns it on. When it is off, /swagger/index.html and /swagger/v1/swagger.json
  // return 404, not 401 and not a redirect: a 404 does not reveal that Swagger is
  // there at all.
  //
  // AllowedIps optionally restricts /swagger to specific addresses, so a QA
  // environment can show it to an office or VPN address without showing it to the
  // internet (Swagger__AllowedIps__0, __1, …). Empty means no IP restriction; a
  // request from an address not on a non-empty list also gets 404.
  "Swagger": {
    "Enabled": false,
    "AllowedIps": []
  },

  // Token issuing. The signing key is a SECRET and is deliberately absent here -
  // see the notice at the top of this file. Supply it as user secrets in
  // development (`dotnet user-secrets set "Jwt:SigningKey" "<value>"`) or as the
  // Jwt__SigningKey environment variable elsewhere. Startup fails if it is
  // missing or shorter than 32 bytes.
  "Jwt": {
    "Issuer": "yalla",
    "Audience": "yalla-clients",
    "AccessTokenMinutes": 15,
    "DeviceTokenDays": 365,
    "StaffSessionMinutes": 30,
    "ParticipantTokenMaxHours": 12,
    "ParticipantReceiptGraceMinutes": 120,
    "ClockSkewSeconds": 30
  },

  // Credential policy. No secrets.
  //
  // MinimumPasswordLength is the only password rule. Composition rules push people
  // towards Password1! and towards a sticky note on the till.
  //
  // ReturnVerificationCodeInResponse has no effect outside Development: the host
  // decides whether it is permitted at all, so setting it in a production
  // environment variable does nothing.
  "Auth": {
    "PinMaxAttempts": 5,
    "PinLockoutMinutes": 15,
    "MinimumPasswordLength": 12,
    "CodeRequestsPerPhonePerHour": 5,
    "ReturnVerificationCodeInResponse": false,
    "PasswordResetUrlTemplate": "http://localhost:5173/reset-password?token={token}",
    "DefaultLocale": "hy"
  },

  // Tabs. JoinUrlTemplate is where the host's share link points; {token} is replaced
  // with the invitation token. The same token backs the QR on the host's screen -
  // the link is only the second way of handing it over (Tabs__JoinUrlTemplate).
  "Tabs": {
    "JoinUrlTemplate": "http://localhost:5173/join?token={token}"
  },

  // The public web pages. ManageBookingUrlTemplate is where a booking's manage link
  // points; {token} is replaced with that booking's manage token.
  //
  // REQUIRED outside Development, and startup fails without it. It is written into the
  // reminder payload at the moment a web booking is created, and only the token's hash
  // is stored - so a booking made while this is wrong carries a dead cancel link
  // forever, and cannot be repaired. The person holding that link is the one diner with
  // no app and therefore no other way to cancel.
  //
  // Must be absolute, http(s), carry {token}, and not point at loopback
  // (PublicWeb__ManageBookingUrlTemplate). Empty here on purpose: supplied per
  // environment, like the connection string. appsettings.Development.json has the local
  // value.
  "PublicWeb": {
    "ManageBookingUrlTemplate": ""
  },

  // What a history of missed bookings costs a diner. Above Threshold no-shows in
  // the last WindowDays, their bookings land as PendingApproval instead of being
  // confirmed instantly - and that is the whole penalty. Nobody is ever banned:
  // Yerevan's dining market is small, and this count cannot tell a serial no-show
  // from somebody whose phone died three times.
  //
  // This is a recommendation, not a settled decision. Enabled: false switches the
  // rule off entirely and also removes a database read from every booking.
  "NoShowPolicy": {
    "Enabled": true,
    "WindowDays": 90,
    "Threshold": 3
  },

  // How long a booking waits for the table's row lock before giving up. Bookers
  // are serialised per table, and the locked span is a range check plus one insert
  // - so five seconds means something is genuinely wrong, not merely busy. A
  // timeout answers 503 with retryable: true, which is deliberately NOT the 409 a
  // real clash gets: one is worth retrying and the other never will be.
  "BookingLock": {
    "LockTimeoutMilliseconds": 5000
  },

  // The operating time zone of the business, as an IANA identifier. Individual
  // branches carry their own Branch.TimeZoneId - every instant in the database is
  // UTC and this is only the default offered when a new branch is created.
  // Armenia has no daylight saving, so UTC+4 holds all year.
  "BusinessDate": {
    "TimeZone": "Asia/Yerevan"
  },

  // Where uploaded photos are written. A folder on this machine, relative to the
  // content root unless the path is absolute. The API refuses to start if it is
  // not writable - a photo pipeline that silently drops uploads is worse than one
  // that will not start.
  //
  // Files are content-addressed: {branchId}/{sha256}/{variant}.webp. Those keys are
  // already storage-agnostic, so moving to a bucket is a copy of the tree and a
  // different IPhotoStorage - see docs/notifications.md, section 10.
  "PhotoStorage": {
    "RootPath": ".photos"
  },

  // The notification dispatcher. Messages are written in the same transaction as
  // the thing that causes them and this loop sends them - see docs/notifications.md.
  //
  // StaleAfterMinutes is the laptop-was-asleep rule and the setting most worth
  // understanding: due messages pile up while a machine is shut, and on wake every
  // one of them fires at once, including a reminder for a dinner that already
  // happened. Anything more overdue than this is dead-lettered with a reason
  // instead of being sent.
  //
  // Enabled: false means messages are still written and nothing sends them. That is
  // a deliberate position - the data is not lost - but the symptom is silence, so
  // watch GET /api/platform/outbox.
  "Outbox": {
    "PollSeconds": 10,
    "BatchSize": 20,
    "LeaseSeconds": 60,
    "MaxAttempts": 5,
    "BaseBackoffSeconds": 30,
    "MaxBackoffSeconds": 3600,
    "StaleAfterMinutes": 60,
    "Enabled": true
  },

  // Where a notification actually goes. "Log" writes the rendered message and its
  // target to the log, which is what makes the scheduler runnable on a machine with
  // no phone attached; "Expo" posts to Expo's push service, which is reachable from
  // localhost with no deployment.
  //
  // ExpoAccessToken is a SECRET and is deliberately absent - supply it as user
  // secrets or the Notifications__ExpoAccessToken environment variable, and only if
  // the Expo project has push security switched on.
  "Notifications": {
    "Channel": "Log",
    "ExpoPushUrl": "https://exp.host/--/api/v2/push/send"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/yalla-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithExceptionDetails"
    ],
    "Properties": {
      "Application": "Yalla"
    }
  }
}
